<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.dkaminski</groupId>
    <artifactId>micrometer-mixed-histogram-shape</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>micrometer-mixed-histogram-shape</name>
    <description>Reproduces a Prometheus scrape that fails with a ClassCastException because one meter of a family carries no histogram</description>

    <properties>
        <java.version>21</java.version>
        <!-- Maintainer asked to measure against 1.18.0-RC1. 1.17.2 is the newest patch of the 1.17 line. -->
        <micrometer.version>1.18.0-RC1</micrometer.version>
        <!-- 1.18.0-RC1 needs the prometheus client that Spring Boot 4.1.0 does not pin yet. -->
        <prometheus-client.version>1.10.0</prometheus-client.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-metrics</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The rejection of a conflicting meter is announced once per JVM, so each test class needs its
                         own JVM. Otherwise the class that runs first consumes the one WARN. -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
